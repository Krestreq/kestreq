
# ==========================================
# Kestreq - Git Ignore
# ==========================================

# Node.js dependencies
node_modules/
backend/node_modules/

# Build outputs
dist/
dist-ssr/
build/
out/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.sample

# Local configuration
*.local

# ==========================================
# Tauri / Rust
# ==========================================

# Rust build artifacts
/target/
/src-tauri/target/

# Cargo lock backup files
Cargo.lock.bak

# Tauri generated build files
/src-tauri/gen/schemas/

# ==========================================
# Database
# ==========================================

# SQLite local databases
*.sqlite
*.sqlite3
*.db
*.db-journal
*.sqlite-shm
*.sqlite-wal

# Keep database migration and schema files
!backend/database/migrations/

# ==========================================
# IDE and Editors
# ==========================================

.vscode/*
!.vscode/extensions.json

.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==========================================
# Operating System
# ==========================================

.DS_Store
Thumbs.db
Desktop.ini

# ==========================================
# Temporary files
# ==========================================

*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# ==========================================
# Coverage and testing
# ==========================================

coverage/
.nyc_output/

# ==========================================
# Package manager
# ==========================================

.pnpm-store/
